#!/usr/bin/env bash
## What to compile and link against libyame.a. Generated by the Makefile from
## yame-config.in, so the answer comes from the build that actually happened
## rather than from a consumer's guess.
##
## Every tool in the suite spelled YAME's dependencies itself, and each spelled
## them differently -- kycg as `$(YAME_LIB) $(YAME_HTSLIB) $(CLIB)`, sesame-cli
## as `$(YAME_LIB) $(HTSLIB) -lpthread $(LDLIBS)`, methscope-cli with its own
## curl variable on top. That divergence is not cosmetic: sesame-cli asked for a
## bare -lcurl while YAME resolved libcurl through curl-config, and on a conda
## toolchain the two picked different libraries and the link failed outright.
## One authoritative answer removes that whole class of problem.
##
##   yame-config --cflags   include paths for #include "assets.h" etc.
##   yame-config --libs     libyame.a + htslib + every transitive dependency
##   yame-config --version  the version string, e.g. v1.13
##   yame-config --prefix   the YAME directory these answers describe
##
## Usage from a consumer's Makefile:
##
##   YAME_DIR ?= external/YAME
##   YAME_CFG := $(YAME_DIR)/yame-config
##   CFLAGS   += $(shell $(YAME_CFG) --cflags)
##   LDLIBS   += $(shell $(YAME_CFG) --libs)
##
## The paths are absolute and point into this build tree: YAME is vendored as a
## submodule and built in place, not installed, so there is nothing to relocate.
set -euo pipefail

prefix="@PREFIX@"
version="@VERSION@"
curl_cflags="@CURL_CFLAGS@"
curl_libs="@CURL_LIBS@"
clib="@CLIB@"

usage() {
  sed -n '2,25p' "$0" | sed 's/^## \{0,1\}//'
  exit 1
}

[ $# -gt 0 ] || usage

for arg in "$@"; do
  case $arg in
    --cflags)
      ## htslib's headers come along because cdata.h and cfile.h include them.
      echo "-I$prefix/src -I$prefix/htslib $curl_cflags"
      ;;
    --libs)
      ## Order matters: libyame.a references htslib, htslib references zlib and
      ## pthreads, and a static archive only resolves leftward. $clib already
      ## carries libcurl when the build found it, so it is not repeated here.
      echo "$prefix/libyame.a $prefix/htslib/libhts.a $clib"
      ;;
    --version) echo "$version" ;;
    --prefix)  echo "$prefix" ;;
    --has-curl)
      ## Exit status, for a consumer that wants to skip its own fetch code.
      [ -n "$curl_libs" ] || exit 1
      ;;
    -h|--help) usage ;;
    *) echo "yame-config: unknown option $arg" >&2; exit 1 ;;
  esac
done
