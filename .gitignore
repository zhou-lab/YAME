# -----------------------------------------------------------------------------
# C/C++ build artifacts, object files, and executables
# -----------------------------------------------------------------------------

# Object files (compiled source code)
*.o
*.obj

# Executable/binary files (compiled programs)
# On Linux/macOS, executables often have no extension (e.g., 'a.out', 'program')
a.out
*.exe
*.out
*.app
*.dll
*.lib
*.so
*.dylib

# Precompiled headers
*.gch
*.pch

# Debugging and symbol files
*.dSYM/
*.pdb

# -----------------------------------------------------------------------------
# Compilation/Build Tool specific directories and files
# -----------------------------------------------------------------------------

# GNU Make
# Generally, exclude all files generated by Make unless they are source files.
# Common build output directory names:
build/
bin/
obj/

# CMake/CTest
# CMake's generated files are typically placed in a top-level 'build' directory,
# but it's good practice to exclude the generated files for an in-source build too.
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Visual Studio / MSVC
# IDE project files and solution files should generally be kept, 
# but temporary files and user settings should be ignored.
# Exclude the entire 'Debug' and 'Release' output folders
[Dd]ebug/
[Rr]elease/
# Temporary files and user settings
*.ilk
*.aps
*.bsc
*.sbr
*.suo
*.user
*.ncb
*.tlog

# Xcode (macOS/iOS)
# Build outputs, user settings, and temporary files
DerivedData/
*.xcodeproj/xcuserdata/

# -----------------------------------------------------------------------------
# Editor/OS Specific Files
# -----------------------------------------------------------------------------

# OS generated files
.DS_Store
Thumbs.db

# Vim/Swap/Backup files
*~
*.swp
.netrwhist

# Emacs backup files
#*#
.#*

# VS Code
.vscode/

# Atom
.atom/

# -----------------------------------------------------------------------------
# Project build artifacts
# -----------------------------------------------------------------------------
# Static libraries (e.g. libyame.a, htslib/libhts.a)
*.a
# The yame CLI binary (no extension)
/yame

# -----------------------------------------------------------------------------
# Scratch
# -----------------------------------------------------------------------------
# Working notes and design drops. Never tracked: the durable record is the lab
# journal org file, and this directory is deleted once the work lands.
/tmp/
# Generated by the Makefile from yame-config.in.
/yame-config

# The test suite is its own repository (zhou-lab/YAME_test) checked out here,
# not a submodule of this one. Untracked it is merely invisible; `git add -A`
# would turn it into a GITLINK -- a submodule pointer to a commit this repo
# has no .gitmodules entry for and nobody can resolve. Ignoring it makes that
# impossible while leaving the suite where test/test.sh expects to find it.
/test/

# htslib writes this during the build; its own `clean` removes it again.
/htslib/version.h

# Stray run log.
/redet.log
